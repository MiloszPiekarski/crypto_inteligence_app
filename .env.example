# Wzór pliku .env.local (lokalny development). Skopiuj do .env.local, uzupełnij wartości
# z Bitwardena i ustaw uprawnienia: chmod 600 .env.local. Plik .env.local jest w .gitignore.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COINGECKO_DEMO_API_KEY=
# Cloudflare R2: Account ID i token konta „Admin Read only” (tylko odczyt; doctor.sh, E0)
CLOUDFLARE_ACCOUNT_ID=
R2_READONLY_API_TOKEN=
# Telegram: token bota z BotFather i chat_id właściciela (alerty od E3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
