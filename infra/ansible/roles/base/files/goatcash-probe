#!/usr/bin/env python3
"""goatcash-probe: jedyne polecenie klucza `goatcash-staging-probe` (authorized_keys użytkownika
deploy z `restrict,command=`). Klucz ma środowisko GitHub `staging-readonly` (bez recenzentów,
bo uruchamia je harmonogram), więc nie może dawać pełnego dostępu jak klucz wdrożeń.

Dozwolone polecenia (SSH_ORIGINAL_COMMAND), wszystkie tylko do odczytu albo nieszkodliwe:
  lynis          audyt Lynis (sudo, tylko /usr/local/bin/goatcash-lynis), wynik i ostrzeżenia;
  restore-point  sumy kontrolne wszystkich tabel staging (JSON jak scripts/pg_checksums.py),
                 potem nazwany punkt przywracania i `pgbackrest check` (WAL do R2), żeby
                 restore-test.yml odtworzył kopię dokładnie do tego punktu i porównał sumy.
Inne polecenie: kod 2. Zapytania SQL są te same co w scripts/pg_checksums.py
(test: scripts/tests/test_probe.py).
"""

import json
import os
import re
import subprocess
import sys
import time

COMPOSE_DIR = "/srv/goatcash/compose"

TABLES = """
SELECT table_schema, table_name FROM information_schema.tables
WHERE table_type = 'BASE TABLE'
  AND table_schema NOT IN ('pg_catalog', 'information_schema')
  AND table_schema NOT LIKE '\\_timescaledb%' AND table_schema NOT LIKE 'timescaledb\\_%'
  AND table_schema NOT LIKE 'pg\\_%'
ORDER BY 1, 2
"""
ROW_SUM = (
    "SELECT count(*), coalesce(md5(string_agg(t::text, E'\\n' ORDER BY t::text)), '') FROM {} AS t"
)
IDENT_RE = re.compile(r"[a-z_][a-z0-9_]*")


def compose_env() -> dict[str, str]:
    with open(os.path.join(COMPOSE_DIR, ".image-tag"), encoding="utf-8") as fh:
        return dict(os.environ, GOATCASH_IMAGE_TAG=fh.read().strip())


def psql(query: str) -> list[list[str]]:
    out = subprocess.run(  # noqa: S603 - stała lista argumentów, zapytania z tego pliku
        [
            "/usr/bin/docker",
            "compose",
            "exec",
            "-T",
            "postgres",
            "psql",
            "-U",
            "postgres",
            "-d",
            "postgres",
            "-X",
            "-At",
            "-F",
            "\t",
            "-v",
            "ON_ERROR_STOP=1",
            "-c",
            query,
        ],
        cwd=COMPOSE_DIR,
        capture_output=True,
        text=True,
        check=True,
        env=compose_env(),
    )
    return [line.split("\t") for line in out.stdout.splitlines() if line]


def restore_point() -> int:
    sums: dict[str, list[object]] = {}
    for schema, table in psql(TABLES):
        # Nazwy z information_schema; tylko proste identyfikatory (inne odrzucamy jawnie,
        # zamiast cytować je ręcznie w SQL).
        if not (IDENT_RE.fullmatch(schema) and IDENT_RE.fullmatch(table)):
            print(f"goatcash-probe: nieobsługiwana nazwa tabeli {schema}.{table}", file=sys.stderr)
            return 1
        count, md5 = psql(ROW_SUM.format(f'"{schema}"."{table}"'))[0]
        sums[f"{schema}.{table}"] = [int(count), md5]
    name = f"goatcash-restore-test-{int(time.time())}"
    psql(f"SELECT pg_create_restore_point('{name}')")
    subprocess.run(
        [
            "/usr/bin/docker",
            "compose",
            "exec",
            "-T",
            "postgres",
            "pgbackrest",
            "--stanza=goatcash",
            "check",
        ],
        cwd=COMPOSE_DIR,
        check=True,
        stdout=subprocess.DEVNULL,
        env=compose_env(),
    )
    print(json.dumps({"restore_point": name, "checksums": sums}, sort_keys=True))
    return 0


def main() -> int:
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()
    if cmd == "lynis":
        lynis = ["/usr/bin/sudo", "-n", "/usr/local/bin/goatcash-lynis"]
        return subprocess.run(lynis, check=False).returncode  # noqa: S603 - stałe polecenie
    if cmd == "restore-point" and os.path.isdir(COMPOSE_DIR):
        return restore_point()
    print(f"goatcash-probe: niedozwolone polecenie: {cmd!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
