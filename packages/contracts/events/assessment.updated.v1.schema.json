{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatcash.app/schemas/events/assessment.updated.v1.schema.json",
  "title": "Zdarzenie assessment.updated (schema_version 1)",
  "description": "Nowa ocena po fuzji dowodów (worker).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "assessment.updated"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "asset",
        "horizon",
        "as_of",
        "p_up",
        "regime",
        "evidence_ids",
        "fusion_version"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,15}$"
        },
        "horizon": {
          "enum": ["1h", "4h", "1d", "7d"]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "p_up": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "regime": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "fusion_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
