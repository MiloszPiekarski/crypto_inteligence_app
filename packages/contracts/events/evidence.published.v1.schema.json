{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatcash.app/schemas/events/evidence.published.v1.schema.json",
  "title": "Zdarzenie evidence.published (schema_version 1)",
  "description": "Nowy dowód agenta (worker).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evidence.published"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "agent",
        "agent_version",
        "asset",
        "horizon",
        "as_of",
        "p_up",
        "status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "agent_version": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,15}$"
        },
        "horizon": {
          "enum": ["1h", "4h", "1d", "7d"]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "p_up": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": ["active", "invalidated", "expired", "settled"]
        }
      }
    }
  }
}
