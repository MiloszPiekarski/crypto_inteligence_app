{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatcash.app/schemas/events/features.ready.v1.schema.json",
  "title": "Zdarzenie features.ready (schema_version 1)",
  "description": "Policzone cechy dla instrumentu i chwili as_of (worker).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "features.ready"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_set",
        "feature_set_version",
        "instrument_id",
        "as_of",
        "data_cutoff",
        "features_count"
      ],
      "properties": {
        "feature_set": {
          "type": "string",
          "minLength": 1
        },
        "feature_set_version": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "type": "integer",
          "minimum": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "data_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "features_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
