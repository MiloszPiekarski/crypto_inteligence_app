{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatcash.app/schemas/events/order.updated.v1.schema.json",
  "title": "Zdarzenie order.updated (schema_version 1)",
  "description": "Zmiana stanu zlecenia na giełdzie (executor przez event_outbox).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "order.updated"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "client_order_id", "status", "filled_quantity", "updated_at"],
      "properties": {
        "intent_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_order_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "open",
            "partially_filled",
            "filled",
            "cancelled",
            "rejected",
            "error"
          ]
        },
        "filled_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "nieujemna liczba dziesiętna jako tekst"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
